# Mindestens 12 Zeichen; wird nur serverseitig von /api/session gelesen.
ADMIN_PASSWORD=ein-langes-sicheres-passwort

# Zufälliger Wert mit mindestens 32 Zeichen zum Signieren der Sitzung.
SESSION_SECRET=hier-einen-zufaelligen-langen-wert-eintragen

# Wird von Vercel automatisch gesetzt, sobald ein Blob Store verbunden ist.
BLOB_READ_WRITE_TOKEN=
