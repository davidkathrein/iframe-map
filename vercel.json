{
  "functions": {
    "api/places.ts": {
      "includeFiles": "src/data/places.json"
    }
  },
  "rewrites": [
    { "source": "/pflege", "destination": "/index.html" },
    { "source": "/pflege/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://imwalgau.at https://www.imwalgau.at" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
